---
layout: null
permalink: /search.json
---
[
{% assign search_separator = '' %}
{% for post in site.posts %}{{ search_separator }}{"kind":"post","title":{{ post.title | jsonify }},"description":{{ post.description | default: '' | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%Y.%m.%d' | jsonify }},"categories":{{ post.categories | jsonify }},"tags":{{ post.tags | jsonify }},"content":{{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% assign search_separator = ',' %}{% endfor %}
{% for category in site.data.notebook_categories %}{% unless category.name == 'ABOUT' %}{% assign category_url = site.category_urls[category.name] %}{{ search_separator }}{"kind":"category","title":{{ category.name | jsonify }},"url":{{ category_url | relative_url | jsonify }},"date":"","categories":[{{ category.name | jsonify }}],"tags":[],"content":{{ category.name | append: ' 카테고리의 글을 연도별로 모았습니다.' | jsonify }}}{% assign search_separator = ',' %}{% endunless %}{% endfor %}
{% assign about_url = site.category_urls['ABOUT'] %}{% assign about_pages = site.pages | where: 'url', about_url %}
{% for about_page in about_pages %}{{ search_separator }}{"kind":"page","title":{{ about_page.title | jsonify }},"url":{{ about_page.url | relative_url | jsonify }},"date":"","categories":[],"tags":[],"content":{{ about_page.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% assign search_separator = ',' %}{% endfor %}
]
